def run_single_instance(instance_id, num_runs=30, verbose=False):
    instance = InstanceLoader(instance_id)
    if verbose:
        instance.summary()

    costs = []
    times = []
    coverages = []
    risk_coverages = []
    energies = []
    batteries = []

    for run in range(num_runs):
        print(f"  Run {run+1}/{num_runs}...", end=' ', flush=True)
        start_time = time.time()
        aco = ACO_VRP_UAV_MultiDepot(
            instance,
            num_ants=ACO_PARAMS['num_ants'],
            max_iterations=ACO_PARAMS['max_iterations'],
            alpha=ACO_PARAMS['alpha'],
            beta=ACO_PARAMS['beta'],
            rho=ACO_PARAMS['rho'],
            q0=ACO_PARAMS['q0'],
            tau0=ACO_PARAMS['tau0'],
            elitist_ants=ACO_PARAMS['elitist_ants'],
            max_trials=ACO_PARAMS['max_trials'],
            verbose=verbose and run == 0
        )
        aco.optimize()
        metrics = aco.get_final_metrics()
        elapsed = time.time() - start_time

        if metrics is not None:
            costs.append(metrics['cost'])
            times.append(elapsed)
            coverages.append(metrics['coverage_ratio'] * 100)          # en %
            risk_coverages.append(metrics['risk_coverage_score'])      # déjà ratio
            energies.append(metrics['total_energy_consumed_wh'])
            batteries.append(metrics['avg_battery_remaining'])         # en %
            print(f"✅ coût = {metrics['cost']:.2f} | cov={metrics['coverage_ratio']*100:.1f}% | "
                  f"risque={metrics['risk_coverage_score']*100:.1f}% | "
                  f"énergie={metrics['total_energy_consumed_wh']:.1f} Wh | "
                  f"batt={metrics['avg_battery_remaining']:.1f}% (temps {elapsed:.2f}s)")
        else:
            print(f"❌ aucun métrique")

    if not costs:
        return None

    return {
        'instance_id': instance_id,
        'num_runs': len(costs),
        'best_cost': min(costs),
        'avg_cost': np.mean(costs),
        'std_cost': np.std(costs),
        'avg_time_sec': np.mean(times),
        'avg_coverage_pct': np.mean(coverages),
        'std_coverage_pct': np.std(coverages),
        'avg_risk_coverage_pct': np.mean(risk_coverages) * 100,
        'std_risk_coverage_pct': np.std(risk_coverages) * 100,
        'avg_energy_wh': np.mean(energies),
        'std_energy_wh': np.std(energies),
        'avg_battery_pct': np.mean(batteries),
        'std_battery_pct': np.std(batteries),
        'all_costs': costs,
        'all_times': times
    }


def run_all_instances(instance_ids, num_runs=30, verbose=False):
    print("=" * 80)
    print("🐜 ACO - EXÉCUTION MULTIPLE SUR PLUSIEURS INSTANCES")
    print(f"   {num_runs} runs par instance")
    print("=" * 80)

    results = []
    for inst_id in instance_ids:
        print(f"\n--- Instance {inst_id} ---")
        try:
            res = run_single_instance(inst_id, num_runs=num_runs, verbose=verbose)
            if res:
                results.append(res)
                print(f"✅ Meilleur coût: {res['best_cost']:.2f}")
                print(f"   Moyenne ± écart-type: {res['avg_cost']:.2f} ± {res['std_cost']:.2f}")
                print(f"   Couverture: {res['avg_coverage_pct']:.1f}% ± {res['std_coverage_pct']:.1f}%")
                print(f"   Risque couvert: {res['avg_risk_coverage_pct']:.1f}% ± {res['std_risk_coverage_pct']:.1f}%")
                print(f"   Énergie: {res['avg_energy_wh']:.1f} Wh ± {res['std_energy_wh']:.1f} Wh")
                print(f"   Batterie: {res['avg_battery_pct']:.1f}% ± {res['std_battery_pct']:.1f}%")
                print(f"   Temps moyen: {res['avg_time_sec']:.2f} s")
            else:
                print(f"❌ Instance {inst_id} : aucun résultat valide")
        except FileNotFoundError as e:
            print(f"❌ Instance {inst_id} non trouvée: {e}")
        except Exception as e:
            print(f"❌ Erreur sur instance {inst_id}: {e}")

    if results:
        print("\n" + "=" * 80)
        print("📊 RÉCAPITULATIF DES RÉSULTATS")
        print("=" * 80)
        print(f"{'Inst':<5} {'Meilleur':<10} {'Moyenne±σ':<18} {'Couverture%':<12} {'Risque%':<10} {'Énergie Wh':<12} {'Batterie%':<10} {'Temps(s)':<10}")
        for res in results:
            print(f"{res['instance_id']:<5} {res['best_cost']:<10.2f} {res['avg_cost']:<8.2f}±{res['std_cost']:<6.2f} "
                  f"{res['avg_coverage_pct']:<7.1f}±{res['std_coverage_pct']:<5.1f} "
                  f"{res['avg_risk_coverage_pct']:<7.1f}±{res['std_risk_coverage_pct']:<5.1f} "
                  f"{res['avg_energy_wh']:<8.1f}±{res['std_energy_wh']:<5.1f} "
                  f"{res['avg_battery_pct']:<7.1f}±{res['std_battery_pct']:<5.1f} "
                  f"{res['avg_time_sec']:<8.2f}")

        output_file = "aco_multiple_runs_results.json"
        with open(output_file, 'w') as f:
            json.dump(results, f, indent=2)
        print(f"\n💾 Résultats sauvegardés dans {output_file}")

    return results


if __name__ == "__main__":
    INSTANCE_IDS = ["7", "8"]
    NUM_RUNS = 30
    VERBOSE = True

    run_all_instances(INSTANCE_IDS, num_runs=NUM_RUNS, verbose=VERBOSE)
