# 🔋 CLASSE DRONE
# ============================================================

class Drone:
    """Drone avec gestion multi-dépôt réaliste."""

    def __init__(self, drone_id, instance):
        self.id = drone_id
        self.instance = instance
        self.speed = instance.cruise_speed
        self.processing_time = instance.processing_time

        self.battery_capacity_mah = instance.battery_capacity
        self.voltage = instance.voltage
        self.battery_capacity_wh = (self.battery_capacity_mah * self.voltage) / 1000
        self.remaining_energy_wh = self.battery_capacity_wh

        self.power_cruising = instance.energy_consumption["cruising"]
        self.power_hovering = instance.energy_consumption["hovering"]
        self.power_processing = instance.energy_consumption["processing"]

        self.start_depot = None
        self.end_depot = None
        self.path = []
        self.flight_time = 0
        self.distance_km = 0
        self.covered_risks = []
        self.energy_consumption_wh = 0
        self.operational_status = "READY"

    def calculate_energy_consumption(self, distance_km, hover_time_min=0, processing_time_min=0):
        cruise_time_h = distance_km / self.speed
        cruise_energy = cruise_time_h * self.power_cruising
        hover_energy = (hover_time_min / 60) * self.power_hovering
        processing_energy = (processing_time_min / 60) * self.power_processing
        return cruise_energy + hover_energy + processing_energy

    def can_reach_with_return_to_any_depot(self, current_pos, target_pos, available_depots, processing_needed=True):
        distance_to_target = self.instance.distance_matrix[current_pos][target_pos]

        min_return_distance = float('inf')
        best_return_depot = available_depots[0] if available_depots else 0
        for depot in available_depots:
            return_distance = self.instance.distance_matrix[target_pos][depot]
            if return_distance < min_return_distance:
                min_return_distance = return_distance
                best_return_depot = depot

        processing_time = self.processing_time if processing_needed else 0
        energy_to_target = self.calculate_energy_consumption(
            distance_to_target,
            hover_time_min=1,
            processing_time_min=processing_time
        )
        energy_return = self.calculate_energy_consumption(min_return_distance)
        total_energy_required = energy_to_target + energy_return
        energy_with_margin = total_energy_required * 1.15

        return (self.remaining_energy_wh >= energy_with_margin,
                total_energy_required,
                best_return_depot)

    def update_operational_status(self):
        battery_pct = self.get_battery_status()['battery_percentage']
        if battery_pct >= 30:
            self.operational_status = "READY"
        elif battery_pct >= 15:
            self.operational_status = "LOW_BATTERY"
        elif battery_pct >= 5:
            self.operational_status = "CRITICAL"
        else:
            self.operational_status = "EMERGENCY"

    def add_mission_leg(self, from_node, to_node, distance_km, risk_score=None, is_processing=True):
        processing_time = self.processing_time if is_processing else 0
        hover_time = 1 if is_processing else 0
        energy_consumed = self.calculate_energy_consumption(
            distance_km,
            hover_time_min=hover_time,
            processing_time_min=processing_time
        )

        if energy_consumed > self.remaining_energy_wh:
            raise ValueError(f"Drone {self.id}: énergie insuffisante!")

        self.remaining_energy_wh -= energy_consumed
        self.energy_consumption_wh += energy_consumed

        leg_time = (distance_km / self.speed) * 60 + processing_time
        self.flight_time += leg_time
        self.distance_km += distance_km
        self.path.append(to_node)

        if risk_score is not None:
            self.covered_risks.append(risk_score)

        self.update_operational_status()

        return {
            'energy_consumed': energy_consumed,
            'time_elapsed': leg_time,
            'battery_remaining_pct': self.get_battery_status()['battery_percentage']
        }

    def get_battery_status(self):
        battery_percentage = (self.remaining_energy_wh / self.battery_capacity_wh) * 100
        avg_energy_per_km = self.power_cruising / self.speed
        remaining_range = 0
        if avg_energy_per_km > 0:
            remaining_range = (self.remaining_energy_wh / avg_energy_per_km) * 0.85

        return {
            'remaining_energy_wh': self.remaining_energy_wh,
            'battery_percentage': battery_percentage,
            'total_consumption_wh': self.energy_consumption_wh,
            'remaining_range_km': remaining_range,
            'operational_status': self.operational_status
        }

    def get_metrics(self):
        battery_status = self.get_battery_status()
        return {
            'drone_id': self.id,
            'start_depot': self.start_depot,
            'end_depot': self.end_depot,
            'tour_length_km': self.distance_km,
            'flight_time_min': self.flight_time,
            'num_targets_visited': len([n for n in self.path if n >= self.instance.num_depots]),
            'total_risk_covered': sum(self.covered_risks),
            'battery_remaining_pct': battery_status['battery_percentage'],
            'energy_consumed_wh': self.energy_consumption_wh,
            'operational_status': self.operational_status,
            'remaining_range_km': battery_status['remaining_range_km'],
            'path': self.path.copy()
        }


