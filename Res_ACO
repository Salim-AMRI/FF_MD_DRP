# ============================================================
# 🐜 ALGORITHME ACO MULTI-DEPOT UAV
# ============================================================

class Ant:
    """Représente une fourmi dans l'algorithme ACO."""

    def __init__(self, ant_id, instance):
        self.id = ant_id
        self.instance = instance
        self.solution = []
        self.visited_targets = set()
        self.current_drone_tours = {}
        self.drones = []
        self.cost = float('inf')
        self.fitness = 0.0

    def reset(self):
        self.solution = []
        self.visited_targets = set()
        self.current_drone_tours = {i: [] for i in range(self.instance.num_drones)}
        self.drones = [Drone(i, self.instance) for i in range(self.instance.num_drones)]

    def get_available_targets(self):
        all_targets = set(range(self.instance.num_depots,
                                self.instance.num_depots + self.instance.num_targets))
        return list(all_targets - self.visited_targets)


class ACO_VRP_UAV_MultiDepot:
    """Implémentation ACO pour le problème UAV multi-dépôt."""

    def __init__(self, instance, num_ants=40, max_iterations=1250,
                 alpha=1.0, beta=2.0, rho=0.1, q0=0.7, tau0=0.1,
                 elitist_ants=5, max_trials=10, verbose=False):

        self.instance = instance
        self.num_ants = num_ants
        self.max_iterations = max_iterations
        self.alpha = alpha
        self.beta = beta
        self.rho = rho
        self.q0 = q0
        self.tau0 = tau0
        self.elitist_ants = elitist_ants
        self.max_trials = max_trials
        self.verbose = verbose

        self.num_targets = instance.num_targets
        self.num_depots = instance.num_depots
        self.num_drones = instance.num_drones
        self.dist_matrix = instance.distance_matrix
        self.risk_scores = instance.risks
        self.available_depots = list(range(self.num_depots))

        self.weights = {
            'distance': 1.0,
            'unvisited': 1000.0,
            'risk': 200.0,
            'low_battery': 100.0,
            'workload': 10.0
        }

        self.ants = [Ant(i, instance) for i in range(num_ants)]
        self.pheromone = np.ones((self.num_drones, self.num_targets)) * tau0
        self.heuristic = self._initialize_heuristic()

        self.best_ant = None
        self.best_cost = float('inf')
        self.best_solution = None
        self.best_metrics = None
        self.evaluation_count = 0
        self.no_improvement_count = 0

    def _initialize_heuristic(self):
        heuristic = np.zeros((self.num_drones, self.num_targets))
        for drone_id in range(self.num_drones):
            for target_idx in range(self.num_targets):
                target_node = target_idx + self.num_depots
                avg_distance = np.mean([self.dist_matrix[target_node][depot]
                                        for depot in self.available_depots])
                risk_factor = self.risk_scores[target_idx] / max(self.risk_scores) if max(self.risk_scores) > 0 else 0
                if avg_distance > 0:
                    heuristic[drone_id, target_idx] = (1.0 / avg_distance) * (1.0 + risk_factor)
                else:
                    heuristic[drone_id, target_idx] = 1.0
        return heuristic

    def _calculate_solution_metrics(self, drones, unvisited):
        total_distance = sum(drone.distance_km for drone in drones)
        visited_targets = self.num_targets - len(unvisited)
        total_risk_covered = sum(sum(drone.covered_risks) for drone in drones)

        max_possible_risk = sum(self.risk_scores)
        if max_possible_risk > 0:
            risk_coverage_ratio = total_risk_covered / max_possible_risk
        else:
            risk_coverage_ratio = 0
        risk_penalty = (1.0 - risk_coverage_ratio) * self.weights['risk']

        distance_term = self.weights['distance'] * total_distance
        unvisited_penalty = self.weights['unvisited'] * len(unvisited)

        low_battery_count = sum(1 for drone in drones
                                if drone.get_battery_status()['battery_percentage'] < 10)
        low_battery_penalty = self.weights['low_battery'] * low_battery_count

        if drones and visited_targets > 0:
            target_counts = [len([n for n in drone.path if n >= self.num_depots]) for drone in drones]
            avg_targets = visited_targets / len(drones)
            workload_imbalance = sum(abs(count - avg_targets) for count in target_counts)
        else:
            workload_imbalance = 0
        workload_penalty = self.weights['workload'] * workload_imbalance

        cost = (distance_term + unvisited_penalty + low_battery_penalty +
                risk_penalty + workload_penalty)
        cost = max(0.1, cost)

        metrics = {
            'total_distance': total_distance,
            'coverage_ratio': visited_targets / self.num_targets if self.num_targets > 0 else 0,
            'risk_coverage_score': risk_coverage_ratio,
            'total_risk_covered': total_risk_covered,
            'unvisited_targets': len(unvisited),
            'visited_targets': visited_targets,
            'total_energy_consumed_wh': sum(drone.energy_consumption_wh for drone in drones),
            'avg_battery_remaining': np.mean([d.get_battery_status()['battery_percentage'] for d in drones]) if drones else 0,
            'cost_components': {
                'distance_term': distance_term,
                'unvisited_penalty': unvisited_penalty,
                'risk_penalty': risk_penalty,
                'low_battery_penalty': low_battery_penalty,
                'workload_penalty': workload_penalty
            },
            'cost': cost
        }
        return cost, metrics

    def _assign_depots_to_drones(self, drones):
        available_depots = self.available_depots.copy()
        depot_assignments = {}
        for drone in drones:
            if available_depots:
                depot_assignments[drone.id] = available_depots.pop(0)
            else:
                depot_assignments[drone.id] = random.choice(self.available_depots)
        return depot_assignments

    def _solution_to_drone_routes(self, solution):
        drone_targets = {i: [] for i in range(self.num_drones)}
        for drone_id, target in solution:
            drone_targets[drone_id].append(target)

        drones = [Drone(i, self.instance) for i in range(self.num_drones)]
        unvisited = set(range(self.num_depots, self.num_depots + self.num_targets))

        depot_assignments = self._assign_depots_to_drones(drones)

        for drone in drones:
            drone.start_depot = depot_assignments[drone.id]
            current_pos = drone.start_depot
            drone.path = [current_pos]

            assigned_targets = drone_targets[drone.id]

            for target in assigned_targets:
                if target not in unvisited:
                    continue
                distance = self.dist_matrix[current_pos][target]
                risk = self.risk_scores[target - self.num_depots]

                can_reach, _, return_depot = drone.can_reach_with_return_to_any_depot(
                    current_pos, target, self.available_depots
                )

                if can_reach and drone.remaining_energy_wh > drone.battery_capacity_wh * 0.1:
                    try:
                        drone.add_mission_leg(current_pos, target, distance, risk, is_processing=True)
                        unvisited.remove(target)
                        current_pos = target
                        drone.end_depot = return_depot
                    except ValueError:
                        break
                else:
                    break

            if current_pos != drone.end_depot and drone.end_depot is not None:
                return_distance = self.dist_matrix[current_pos][drone.end_depot]
                try:
                    drone.add_mission_leg(current_pos, drone.end_depot, return_distance, is_processing=False)
                except ValueError:
                    drone.operational_status = "EMERGENCY_LANDING"

        return drones, list(unvisited)

    def _construct_solution(self, ant):
        ant.reset()
        available_targets = list(range(self.num_depots, self.num_depots + self.num_targets))

        depot_assignments = {}
        for drone in ant.drones:
            depot_assignments[drone.id] = random.choice(self.available_depots)
            drone.start_depot = depot_assignments[drone.id]
            drone.path = [depot_assignments[drone.id]]

        while available_targets and any(drone.remaining_energy_wh > drone.battery_capacity_wh * 0.1
                                        for drone in ant.drones):
            available_drones = [drone for drone in ant.drones
                                if drone.remaining_energy_wh > drone.battery_capacity_wh * 0.1]
            if not available_drones:
                break

            drone = min(available_drones,
                        key=lambda d: len([n for n in d.path if n >= self.num_depots]))
            current_pos = drone.path[-1]

            accessible_targets = []
            probabilities = []
            for target in available_targets:
                target_idx = target - self.num_depots
                can_reach, _, _ = drone.can_reach_with_return_to_any_depot(
                    current_pos, target, self.available_depots
                )
                if can_reach:
                    tau = max(1e-10, self.pheromone[drone.id, target_idx])
                    eta = max(1e-10, self.heuristic[drone.id, target_idx])
                    prob = (tau ** self.alpha) * (eta ** self.beta)
                    accessible_targets.append(target)
                    probabilities.append(prob)

            if not accessible_targets:
                break

            probabilities = np.array(probabilities)
            if np.sum(probabilities) > 0:
                probabilities = probabilities / np.sum(probabilities)
            else:
                probabilities = np.ones(len(probabilities)) / len(probabilities)

            if random.random() < self.q0:
                selected_idx = np.argmax(probabilities)
            else:
                try:
                    selected_idx = np.random.choice(len(accessible_targets), p=probabilities)
                except ValueError:
                    selected_idx = random.randint(0, len(accessible_targets) - 1)

            selected_target = accessible_targets[selected_idx]
            selected_idx_global = selected_target - self.num_depots

            distance = self.dist_matrix[current_pos][selected_target]
            risk = self.risk_scores[selected_idx_global]

            try:
                _, _, return_depot = drone.can_reach_with_return_to_any_depot(
                    current_pos, selected_target, self.available_depots
                )
                drone.add_mission_leg(current_pos, selected_target, distance, risk, is_processing=True)
                drone.end_depot = return_depot
                ant.solution.append((drone.id, selected_target))
                ant.visited_targets.add(selected_target)
                available_targets.remove(selected_target)
            except ValueError:
                break

        for drone in ant.drones:
            if drone.path[-1] != drone.end_depot and drone.end_depot is not None:
                current_pos = drone.path[-1]
                return_distance = self.dist_matrix[current_pos][drone.end_depot]
                try:
                    drone.add_mission_leg(current_pos, drone.end_depot, return_distance, is_processing=False)
                except ValueError:
                    drone.operational_status = "EMERGENCY_LANDING"

        return ant

    def _calculate_ant_solution_cost(self, ant):
        all_targets = set(range(self.num_depots, self.num_depots + self.num_targets))
        unvisited = all_targets - ant.visited_targets
        solution = ant.solution.copy()
        for target in unvisited:
            solution.append((0, target))

        drones, unvisited_list = self._solution_to_drone_routes(solution)
        cost, metrics = self._calculate_solution_metrics(drones, unvisited_list)

        self.evaluation_count += 1
        return cost, drones, unvisited_list, metrics, solution

    def _update_pheromone(self, ants):
        self.pheromone *= (1.0 - self.rho)
        for ant in ants:
            if ant.cost > 0:
                delta_tau = 1.0 / ant.cost
            else:
                delta_tau = 1.0
            for drone_id, target in ant.solution:
                target_idx = target - self.num_depots
                self.pheromone[drone_id, target_idx] += delta_tau

        if self.best_solution:
            elitist_delta = self.elitist_ants * (1.0 / max(self.best_cost, 0.1))
            for drone_id, target in self.best_solution:
                target_idx = target - self.num_depots
                self.pheromone[drone_id, target_idx] += elitist_delta

        self.pheromone = np.clip(self.pheromone, 1e-10, 10.0)

    def _apply_local_search(self, solution):
        improved_solution = solution.copy()
        if len(improved_solution) < 2:
            return improved_solution

        operators = ['swap', 'relocate', '2-opt', 'reassign']
        for operator in operators:
            if operator == 'swap' and len(improved_solution) >= 2:
                i, j = random.sample(range(len(improved_solution)), 2)
                improved_solution[i], improved_solution[j] = improved_solution[j], improved_solution[i]
            elif operator == 'relocate' and len(improved_solution) >= 2:
                i, j = random.sample(range(len(improved_solution)), 2)
                if i != j:
                    item = improved_solution.pop(i)
                    improved_solution.insert(j, item)
            elif operator == 'reassign':
                idx = random.randint(0, len(improved_solution) - 1)
                new_drone = random.randint(0, self.num_drones - 1)
                improved_solution[idx] = (new_drone, improved_solution[idx][1])
        return improved_solution

    def optimize(self):
        if self.verbose:
            print(f"🐜 Démarrage ACO avec {self.max_iterations} itérations...")

        for iteration in range(self.max_iterations):
            iteration_start = time.time()

            for ant in self.ants:
                ant = self._construct_solution(ant)
                cost, drones, unvisited, metrics, full_solution = self._calculate_ant_solution_cost(ant)
                ant.cost = cost
                ant.drones = drones

                if random.random() < 0.3:
                    local_solution = self._apply_local_search(full_solution)
                    local_cost, local_drones, local_unvisited, local_metrics, _ = self._calculate_ant_solution_cost(ant)
                    if local_cost < ant.cost:
                        ant.cost = local_cost
                        ant.solution = local_solution
                        ant.drones = local_drones
                        metrics = local_metrics

                if ant.cost < self.best_cost:
                    self.best_cost = ant.cost
                    self.best_solution = ant.solution.copy()
                    self.best_metrics = metrics
                    self.best_ant = ant
                    self.no_improvement_count = 0
                else:
                    self.no_improvement_count += 1

            self._update_pheromone(self.ants)

            if self.no_improvement_count > self.max_trials * 5:
                self.pheromone = (self.pheromone * 0.5) + (np.ones_like(self.pheromone) * self.tau0 * 0.5)
                self.no_improvement_count = 0

            iteration_time = time.time() - iteration_start

            if self.verbose and (iteration % 100 == 0 or iteration == self.max_iterations - 1):
                coverage = self.best_metrics['coverage_ratio'] if self.best_metrics else 0
                battery_avg = self.best_metrics['avg_battery_remaining'] if self.best_metrics else 0
                print(f"Iter {iteration+1:4d}/{self.max_iterations} | "
                      f"Best Cost: {self.best_cost:8.2f} | "
                      f"Coverage: {coverage:5.1%} | "
                      f"Battery: {battery_avg:5.1f}% | "
                      f"Evals: {self.evaluation_count:6d}")

        if self.verbose:
            print(f"✅ Optimisation ACO terminée !")

    def get_final_metrics(self):
        if not self.best_metrics:
            return None
        return {
            'total_distance': self.best_metrics['total_distance'],
            'coverage_ratio': self.best_metrics['coverage_ratio'],
            'risk_coverage_score': self.best_metrics['risk_coverage_score'],
            'total_risk_covered': self.best_metrics['total_risk_covered'],
            'unvisited_targets': self.best_metrics['unvisited_targets'],
            'visited_targets': self.best_metrics['visited_targets'],
            'total_energy_consumed_wh': self.best_metrics['total_energy_consumed_wh'],
            'avg_battery_remaining': self.best_metrics['avg_battery_remaining'],
            'cost_components': self.best_metrics['cost_components'],
            'cost': self.best_metrics['cost'],
        }

