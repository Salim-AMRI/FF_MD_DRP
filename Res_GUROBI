def main():
    """Programme principal."""
    print("="*80)
    print("🧠 GUROBI SOLVER - VERSION FINALE CORRIGÉE")
    print("="*80)
    print("\n✅ CORRECTIONS:")
    print("   1. ✅ Variable z[d] pour drone utilisé")
    print("   2. ✅ Flux uniquement sur cibles")
    print("   3. ✅ Syntaxe Gurobi valide")
    print("   4. ✅ Objectif identique à BCO")
    print("="*80)

    instance_id = "4"
    time_limit = 180

    try:
        # Charger l'instance
        print(f"\n📥 CHARGEMENT INSTANCE {instance_id}...")
        instance = InstanceLoader(instance_id)
        instance.summary()

        # Vérifications
        print(f"\n🔍 VÉRIFICATIONS:")
        max_range_energy = (instance.battery_capacity * instance.voltage / 1000) / (instance.energy_consumption["cruising"] / instance.cruise_speed)
        max_range_time = (instance.max_flight_time / 60) * instance.cruise_speed
        max_range = min(max_range_energy, max_range_time)
        print(f"   • Portée max: {max_range:.1f} km")

        # Résolution
        print(f"\n⚡ RÉSOLUTION AVEC GUROBI...")
        solution = solve_uav_vrp_gurobi_exact(
            instance,
            time_limit=time_limit,
            mip_gap=0.01,
            verbose=True
        )

        if solution is None:
            print("\n❌ PAS DE SOLUTION")
            print("   Vérifier model_iis.ilp pour diagnostic")
            return

        # Succès
        print(f"\n{'✅'*20}")
        print("SUCCÈS!")
        print(f"{'✅'*20}")

        if solution['status'] == GRB.OPTIMAL:
            print(f"🎯 Solution OPTIMALE prouvée!")
        elif solution['mip_gap'] < 0.01:
            print(f"📈 Solution de haute qualité (gap: {solution['mip_gap']*100:.2f}%)")
        else:
            print(f"📊 Solution trouvée (gap: {solution['mip_gap']*100:.2f}%)")

        print(f"\n📊 RÉSULTATS:")
        print(f"   • Coût: {solution['cost_components']['total_cost']:.2f}")
        print(f"   • Couverture: {solution['coverage_ratio']:.1%}")
        print(f"   • Distance: {solution['total_distance']:.2f} km")
        print(f"   • Temps: {solution['solve_time']:.2f}s")

    except Exception as e:
        print(f"\n❌ ERREUR: {e}")
        import traceback
        traceback.print_exc()

    print(f"\n{'='*80}")
    print("FIN")
    print(f"{'='*80}")

