PSO_PARAMS = {
    'num_particles': 40,
    'max_iterations': 1250,
    'inertia_weight': 0.729,
    'cognitive_coeff': 1.49445,
    'social_coeff': 1.49445,
    'velocity_clamp': 4.0,
    'mutation_rate': 0.1
}


# ============================================================
# 🐟 ALGORITHME PSO MULTI-DEPOT UAV
# ============================================================

class PSO_VRP_UAV_MultiDepot:
    def __init__(self, instance, num_particles=40, max_iterations=1250,
                 inertia_weight=0.729, cognitive_coeff=1.49445, social_coeff=1.49445,
                 velocity_clamp=4.0, mutation_rate=0.1, verbose=False):
        self.instance = instance
        self.num_particles = num_particles
        self.max_iterations = max_iterations
        self.w = inertia_weight
        self.c1 = cognitive_coeff
        self.c2 = social_coeff
        self.v_clamp = velocity_clamp
        self.mutation_rate = mutation_rate
        self.verbose = verbose

        self.num_targets = instance.num_targets
        self.num_depots = instance.num_depots
        self.num_drones = instance.num_drones
        self.dist_matrix = instance.distance_matrix
        self.risk_scores = instance.risks
        self.available_depots = list(range(self.num_depots))

        self.weights = {
            'distance': 1.0,
            'unvisited': 1000.0,
            'risk': 200.0,
            'low_battery': 100.0,
            'workload': 10.0
        }

        self.gbest_position = None
        self.gbest_cost = float('inf')
        self.gbest_metrics = None
        self.evaluation_count = 0

        self.particles = self._initialize_particles()
        self.velocities = self._initialize_velocities()

    def _initialize_particles(self):
        particles = []
        for i in range(self.num_particles):
            solution = self._generate_random_solution()
            cost, _, _, metrics = self._calculate_solution_cost(solution)

            particle = {
                'id': i,
                'position': solution,
                'velocity': None,
                'cost': cost,
                'pbest_position': solution.copy(),
                'pbest_cost': cost,
                'metrics': metrics
            }
            particles.append(particle)
            self.evaluation_count += 1

        return particles

    def _initialize_velocities(self):
        velocities = []
        for particle in self.particles:
            velocity = []
            for _ in range(len(particle['position'])):
                velocity.append({
                    'swap_prob': random.uniform(-1, 1),
                    'reassign_prob': random.uniform(-1, 1)
                })
            velocities.append(velocity)
        return velocities

    def _generate_random_solution(self):
        solution = []
        all_targets = list(range(self.num_depots, self.num_depots + self.num_targets))
        random.shuffle(all_targets)

        targets_per_drone = len(all_targets) // self.num_drones
        for drone_id in range(self.num_drones):
            start_idx = drone_id * targets_per_drone
            end_idx = start_idx + targets_per_drone if drone_id < self.num_drones - 1 else len(all_targets)
            for target in all_targets[start_idx:end_idx]:
                solution.append((drone_id, target))

        remaining_targets = all_targets[end_idx:] if self.num_drones > 1 else []
        for i, target in enumerate(remaining_targets):
            solution.append((i % self.num_drones, target))

        return solution

    def _solution_to_drone_routes(self, solution):
        drone_targets = {i: [] for i in range(self.num_drones)}
        for drone_id, target in solution:
            drone_targets[drone_id].append(target)

        drones = [Drone(i, self.instance) for i in range(self.num_drones)]
        unvisited = set(range(self.num_depots, self.num_depots + self.num_targets))

        depot_assignments = self._assign_depots_to_drones(drones)

        for drone in drones:
            drone.start_depot = depot_assignments[drone.id]
            current_pos = drone.start_depot
            drone.path = [current_pos]

            assigned_targets = drone_targets[drone.id]

            for target in assigned_targets:
                if target not in unvisited:
                    continue

                distance = self.dist_matrix[current_pos][target]
                risk = self.risk_scores[target - self.num_depots]

                can_reach, _, return_depot = drone.can_reach_with_return_to_any_depot(
                    current_pos, target, self.available_depots
                )

                if can_reach and drone.remaining_energy_wh > drone.battery_capacity_wh * 0.1:
                    try:
                        drone.add_mission_leg(current_pos, target, distance, risk, is_processing=True)
                        unvisited.remove(target)
                        current_pos = target
                        drone.end_depot = return_depot
                    except ValueError:
                        break
                else:
                    break

            if current_pos != drone.end_depot and drone.end_depot is not None:
                return_distance = self.dist_matrix[current_pos][drone.end_depot]
                try:
                    drone.add_mission_leg(current_pos, drone.end_depot, return_distance, is_processing=False)
                except ValueError:
                    drone.operational_status = "EMERGENCY_LANDING"

        return drones, list(unvisited)

    def _assign_depots_to_drones(self, drones):
        available_depots = self.available_depots.copy()
        depot_assignments = {}
        for drone in drones:
            if available_depots:
                depot_assignments[drone.id] = available_depots.pop(0)
            else:
                depot_assignments[drone.id] = random.choice(self.available_depots)
        return depot_assignments

    def _calculate_solution_metrics(self, drones, unvisited):
        total_distance = sum(drone.distance_km for drone in drones)
        visited_targets = self.num_targets - len(unvisited)
        total_risk_covered = sum(sum(drone.covered_risks) for drone in drones)

        max_possible_risk = sum(self.risk_scores)
        if max_possible_risk > 0:
            risk_coverage_ratio = total_risk_covered / max_possible_risk
        else:
            risk_coverage_ratio = 0
        risk_penalty = (1.0 - risk_coverage_ratio) * self.weights['risk']

        distance_term = self.weights['distance'] * total_distance
        unvisited_penalty = self.weights['unvisited'] * len(unvisited)

        low_battery_count = sum(1 for drone in drones
                                if drone.get_battery_status()['battery_percentage'] < 10)
        low_battery_penalty = self.weights['low_battery'] * low_battery_count

        if drones and visited_targets > 0:
            target_counts = [len([n for n in drone.path if n >= self.num_depots]) for drone in drones]
            avg_targets = visited_targets / len(drones)
            workload_imbalance = sum(abs(count - avg_targets) for count in target_counts)
        else:
            workload_imbalance = 0
        workload_penalty = self.weights['workload'] * workload_imbalance

        cost = (distance_term + unvisited_penalty + low_battery_penalty +
                risk_penalty + workload_penalty)
        cost = max(0.1, cost)

        metrics = {
            'total_distance': total_distance,
            'coverage_ratio': visited_targets / self.num_targets if self.num_targets > 0 else 0,
            'risk_coverage_score': risk_coverage_ratio,
            'total_risk_covered': total_risk_covered,
            'unvisited_targets': len(unvisited),
            'visited_targets': visited_targets,
            'total_energy_consumed_wh': sum(drone.energy_consumption_wh for drone in drones),
            'avg_battery_remaining': np.mean([d.get_battery_status()['battery_percentage'] for d in drones]) if drones else 0,
            'cost_components': {
                'distance_term': distance_term,
                'unvisited_penalty': unvisited_penalty,
                'risk_penalty': risk_penalty,
                'low_battery_penalty': low_battery_penalty,
                'workload_penalty': workload_penalty
            },
            'cost': cost
        }
        return cost, metrics

    def _calculate_solution_cost(self, solution):
        drones, unvisited = self._solution_to_drone_routes(solution)
        cost, metrics = self._calculate_solution_metrics(drones, unvisited)
        self.evaluation_count += 1
        return cost, drones, unvisited, metrics

    def _apply_velocity(self, position, velocity):
        new_position = position.copy()
        for i in range(len(position)):
            if random.random() < abs(velocity[i]['swap_prob']):
                if len(position) > 1:
                    j = random.randint(0, len(position) - 1)
                    new_position[i], new_position[j] = new_position[j], new_position[i]
            if random.random() < abs(velocity[i]['reassign_prob']):
                new_drone = random.randint(0, self.num_drones - 1)
                new_position[i] = (new_drone, new_position[i][1])
        return new_position

    def _update_velocity(self, velocity, pbest_pos, gbest_pos, position):
        new_velocity = []
        for i in range(len(velocity)):
            r1, r2 = random.random(), random.random()
            pbest_diff_swap = 1.0 if pbest_pos[i] != position[i] else -1.0
            gbest_diff_swap = 1.0 if gbest_pos[i] != position[i] else -1.0
            pbest_diff_reassign = 1.0 if pbest_pos[i][0] != position[i][0] else -1.0
            gbest_diff_reassign = 1.0 if gbest_pos[i][0] != position[i][0] else -1.0

            new_swap = (self.w * velocity[i]['swap_prob'] +
                        self.c1 * r1 * pbest_diff_swap +
                        self.c2 * r2 * gbest_diff_swap)
            new_reassign = (self.w * velocity[i]['reassign_prob'] +
                            self.c1 * r1 * pbest_diff_reassign +
                            self.c2 * r2 * gbest_diff_reassign)

            new_swap = max(-self.v_clamp, min(self.v_clamp, new_swap))
            new_reassign = max(-self.v_clamp, min(self.v_clamp, new_reassign))

            new_velocity.append({
                'swap_prob': new_swap,
                'reassign_prob': new_reassign
            })
        return new_velocity

    def _mutate_solution(self, solution):
        if random.random() > self.mutation_rate or len(solution) < 2:
            return solution
        mutated = solution.copy()
        mutation_type = random.choice(['swap', 'insert', 'reverse', 'reassign'])
        if mutation_type == 'swap' and len(mutated) >= 2:
            i, j = random.sample(range(len(mutated)), 2)
            mutated[i], mutated[j] = mutated[j], mutated[i]
        elif mutation_type == 'insert' and len(mutated) >= 2:
            i, j = random.sample(range(len(mutated)), 2)
            if i != j:
                item = mutated.pop(i)
                mutated.insert(j, item)
        elif mutation_type == 'reverse' and len(mutated) >= 2:
            i, j = sorted(random.sample(range(len(mutated)), 2))
            mutated[i:j+1] = reversed(mutated[i:j+1])
        elif mutation_type == 'reassign':
            idx = random.randint(0, len(mutated) - 1)
            new_drone = random.randint(0, self.num_drones - 1)
            mutated[idx] = (new_drone, mutated[idx][1])
        return mutated

    def optimize(self):
        if self.verbose:
            print(f"🐟 Démarrage PSO avec {self.max_iterations} itérations...")

        for particle in self.particles:
            if particle['cost'] < self.gbest_cost:
                self.gbest_cost = particle['cost']
                self.gbest_position = particle['position'].copy()
                self.gbest_metrics = particle['metrics']

        for iteration in range(self.max_iterations):
            for i, particle in enumerate(self.particles):
                self.velocities[i] = self._update_velocity(
                    self.velocities[i],
                    particle['pbest_position'],
                    self.gbest_position,
                    particle['position']
                )

                new_position = self._apply_velocity(particle['position'], self.velocities[i])
                if random.random() < self.mutation_rate:
                    new_position = self._mutate_solution(new_position)

                new_cost, new_drones, new_unvisited, new_metrics = self._calculate_solution_cost(new_position)
                self.evaluation_count += 1

                if new_cost < particle['pbest_cost']:
                    particle['pbest_position'] = new_position.copy()
                    particle['pbest_cost'] = new_cost
                    particle['metrics'] = new_metrics

                particle['position'] = new_position
                particle['cost'] = new_cost

                if new_cost < self.gbest_cost:
                    self.gbest_cost = new_cost
                    self.gbest_position = new_position.copy()
                    self.gbest_metrics = new_metrics

            if self.verbose and (iteration % 100 == 0 or iteration == self.max_iterations - 1):
                coverage = self.gbest_metrics['coverage_ratio'] if self.gbest_metrics else 0
                battery_avg = self.gbest_metrics['avg_battery_remaining'] if self.gbest_metrics else 0
                print(f"Iter {iteration+1:4d}/{self.max_iterations} | "
                      f"Best Cost: {self.gbest_cost:8.2f} | "
                      f"Coverage: {coverage:5.1%} | "
                      f"Battery: {battery_avg:5.1f}% | "
                      f"Evals: {self.evaluation_count:6d}")

            if iteration % 200 == 0 and iteration > 0:
                self.w = max(0.4, self.w * 0.99)

        if self.verbose:
            print(f"✅ Optimisation PSO terminée !")

    def get_final_metrics(self):
        if not self.gbest_metrics:
            return None
        return {
            'total_distance': self.gbest_metrics['total_distance'],
            'coverage_ratio': self.gbest_metrics['coverage_ratio'],
            'risk_coverage_score': self.gbest_metrics['risk_coverage_score'],
            'total_risk_covered': self.gbest_metrics['total_risk_covered'],
            'unvisited_targets': self.gbest_metrics['unvisited_targets'],
            'visited_targets': self.gbest_metrics['visited_targets'],
            'total_energy_consumed_wh': self.gbest_metrics['total_energy_consumed_wh'],
            'avg_battery_remaining': self.gbest_metrics['avg_battery_remaining'],
            'cost_components': self.gbest_metrics['cost_components'],
            'cost': self.gbest_metrics['cost'],
        }

# ============================================================
# 🧪 EXÉCUTION MULTIPLE SUR PLUSIEURS INSTANCES
# ============================================================

def run_single_instance(instance_id, num_runs=30, verbose=False):
    instance = InstanceLoader(instance_id)
    if verbose:
        instance.summary()

    costs = []
    times = []
    coverages = []
    risk_coverages = []
    energies = []
    batteries = []

    for run in range(num_runs):
        print(f"  Run {run+1}/{num_runs}...", end=' ', flush=True)
        start_time = time.time()
        pso = PSO_VRP_UAV_MultiDepot(
            instance,
            num_particles=PSO_PARAMS['num_particles'],
            max_iterations=PSO_PARAMS['max_iterations'],
            inertia_weight=PSO_PARAMS['inertia_weight'],
            cognitive_coeff=PSO_PARAMS['cognitive_coeff'],
            social_coeff=PSO_PARAMS['social_coeff'],
            velocity_clamp=PSO_PARAMS['velocity_clamp'],
            mutation_rate=PSO_PARAMS['mutation_rate'],
            verbose=verbose and run == 0
        )
        pso.optimize()
        metrics = pso.get_final_metrics()
        elapsed = time.time() - start_time

        if metrics is not None:
            costs.append(metrics['cost'])
            times.append(elapsed)
            coverages.append(metrics['coverage_ratio'] * 100)
            risk_coverages.append(metrics['risk_coverage_score'])
            energies.append(metrics['total_energy_consumed_wh'])
            batteries.append(metrics['avg_battery_remaining'])
            print(f"✅ coût = {metrics['cost']:.2f} | cov={metrics['coverage_ratio']*100:.1f}% | "
                  f"risque={metrics['risk_coverage_score']*100:.1f}% | "
                  f"énergie={metrics['total_energy_consumed_wh']:.1f} Wh | "
                  f"batt={metrics['avg_battery_remaining']:.1f}% (temps {elapsed:.2f}s)")
        else:
            print(f"❌ aucun métrique")

    if not costs:
        return None

    return {
        'instance_id': instance_id,
        'num_runs': len(costs),
        'best_cost': min(costs),
        'avg_cost': np.mean(costs),
        'std_cost': np.std(costs),
        'avg_time_sec': np.mean(times),
        'avg_coverage_pct': np.mean(coverages),
        'std_coverage_pct': np.std(coverages),
        'avg_risk_coverage_pct': np.mean(risk_coverages) * 100,
        'std_risk_coverage_pct': np.std(risk_coverages) * 100,
        'avg_energy_wh': np.mean(energies),
        'std_energy_wh': np.std(energies),
        'avg_battery_pct': np.mean(batteries),
        'std_battery_pct': np.std(batteries),
        'all_costs': costs,
        'all_times': times
    }


def run_all_instances(instance_ids, num_runs=30, verbose=False):
    print("=" * 80)
    print("🐟 PSO - EXÉCUTION MULTIPLE SUR PLUSIEURS INSTANCES")
    print(f"   {num_runs} runs par instance")
    print("=" * 80)

    results = []
    for inst_id in instance_ids:
        print(f"\n--- Instance {inst_id} ---")
        try:
            res = run_single_instance(inst_id, num_runs=num_runs, verbose=verbose)
            if res:
                results.append(res)
